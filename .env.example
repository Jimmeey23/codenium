# Supabase Postgres connection string.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the Session pooler (port 5432) or Transaction pooler (port 6543) host.
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your own values.
# IMPORTANT: percent-encode special characters in the password (@ -> %40, # -> %23,
# / -> %2F, : -> %3A). An unescaped @ breaks URL parsing and the connection fails.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local dev alternative (supabase start / plain Postgres):
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"
